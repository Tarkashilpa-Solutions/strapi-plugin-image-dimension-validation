{
  "version": "1.0.3",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "image-validation",
    "image-dimensions",
    "image-dimension-validation",
    "image-size-validation",
    "aspect-ratio",
    "media-library",
    "media-validation"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "admin",
    "server",
    "strapi-server.js",
    "strapi-admin.js"
  ],
  "engines": {
    "node": ">=18.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "tsc -p admin/tsconfig.json",
    "test:ts:back": "tsc -p server/tsconfig.json",
    "test": "jest --forceExit --detectOpenHandles",
    "test:unit": "jest --forceExit --testPathPatterns \"(server|admin).*src\"",
    "test:integration": "jest --forceExit --detectOpenHandles --testPathPatterns \"tests/integration\"",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      ".tmp",
      ".cache",
      "/dist/"
    ],
    "roots": [
      "<rootDir>/tests"
    ],
    "collectCoverageFrom": [
      "admin/src/**/*.{ts,tsx}",
      "server/src/**/*.ts"
    ],
    "moduleNameMapper": {
      "^@strapi/strapi$": "<rootDir>/tests/__mocks__/strapi.ts",
      "^@strapi/utils$": "<rootDir>/node_modules/@strapi/utils"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tests/tsconfig.json"
        }
      ]
    }
  },
  "dependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0"
  },
  "devDependencies": {
    "@strapi/admin": "^5.0.0",
    "@strapi/plugin-users-permissions": "^5.0.0",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.0.0",
    "@strapi/typescript-utils": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.31",
    "@types/supertest": "^7.2.1",
    "better-sqlite3": "^12.11.1",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.4",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "yup": "^0.32.9"
  },
  "peerDependencies": {
    "@strapi/admin": "^5.0.0",
    "@strapi/strapi": "^5.0.0",
    "@strapi/utils": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0",
    "yup": "^0.32.9"
  },
  "strapi": {
    "kind": "plugin",
    "name": "image-validation",
    "displayName": "Image Validation",
    "description": "Validates images selected through Strapi's Media Library against configurable aspect ratio and dimension requirements."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tarkashilpa-Solutions/strapi-plugin-image-dimension-validation.git"
  },
  "name": "@tarkashilpa/strapi-plugin-image-dimension-validation",
  "description": "Validates images selected through Strapi's Media Library against configurable aspect ratio and dimension requirements.",
  "license": "MIT",
  "author": "prayash-c <prayash.chettri@tarkashilpa.com>"
}
